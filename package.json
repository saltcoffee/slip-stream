{
  "name": "slipstream",
  "version": "0.1.3",
  "description": "Turn folders and tags into a continuous, draggable card stream for effortless long-form writing.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "gua",
  "repository": {
    "type": "git",
    "url": "https://github.com/saltcoffee/slip-stream.git"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit -skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:release",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "cards",
    "citations"
  ],
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/markdown-it": "^14.1.0",
    "esbuild": "^0.20.0",
    "jsdom": "^24.0.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
